# Allow-list: only what the image needs is sent to `docker build`.
# Anything else in the folder (local venvs like .venv-deps, benchmark output, IDE files...)
# is never read, so it cannot break or bloat the build on anyone's machine.
*
!Dockerfile
!pyproject.toml
!requirements.txt
!constraints.txt
!README.md
!quantumtrace/
!app/
!.streamlit/
!samples/
!tests/
!frontend/
!scripts/

# junk that can live inside the allowed folders
**/__pycache__
**/*.pyc
**/*.egg-info
**/.pytest_cache
frontend/node_modules
frontend/.output
frontend/dist
frontend/.tanstack
samples/extra/tls-lab/modern/tlslab-modern-test
samples/extra/tls-lab/legacy/tlslab-legacy-test
